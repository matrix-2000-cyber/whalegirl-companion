{
  "name": "dsh-qq-bridge",
  "version": "0.4.0",
  "type": "module",
  "main": "index.js",
  "description": "Bridge one fixed DSH session to QQ (OneBot/NapCat) and keep its context: fail-closed whitelist, @/nickname wake, configurable-probability wake, everything else only recorded. 把一个固定的 DSH 会话接到 QQ（OneBot/NapCat）：白名单 + @/昵称必唤醒 + 概率唤醒，其余只记录，保留原上下文。",
  "license": "MIT",
  "author": "sj244",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "onebot",
    "napcat",
    "qq",
    "bridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj244/dsh-qq-bridge.git"
  },
  "homepage": "https://github.com/sj244/dsh-qq-bridge#readme",
  "bugs": {
    "url": "https://github.com/sj244/dsh-qq-bridge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./onebot.js": "./onebot.js",
    "./napcat.js": "./napcat.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "onebot.js",
    "napcat.js",
    "stickers.js",
    "client",
    "assets",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "extras.js",
    "delivery.js",
    "greetings.js",
    "video.js",
    "drawing.js",
    "token-policy.js",
    "emotion.js",
    "voice.js",
    "voice-in.js",
    "persona.txt",
    "mobile.js",
    "camera-vision.js",
    "reply-progress.js",
    "realtime-session.js",
    "managed-owner.js"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules --test --test-isolation=none test/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
